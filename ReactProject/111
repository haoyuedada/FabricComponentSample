hdc shell param set persist.ace.debug.enabled 1
hdc shell setenforce 0

hdc shell "hidumper -s WindowManagerService -a '-a'"
@set /p windowId=input WindowId :

for /F %%i in ('hdc shell "find data/ -name arkui.dump"') do (
	hdc shell "rm %%i"
)
::old pipeline
::hdc shell "hidumper -s WindowManagerService -a '-w %windowId% -render -c'"

::ng
rem hdc shell "hidumper -s WindowManagerService -a '-w %windowId% -element -c -json'" > arkui.dump
hdc shell "hidumper -s WindowManagerService -a '-w %windowId% -default'" > arkui.dump 
for /F %%i in ('hdc shell "find data/ -name arkui.dump"') do (
    hdc file recv %%i .
)
pause
