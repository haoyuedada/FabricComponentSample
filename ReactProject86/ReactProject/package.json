{
  "name": "ReactProject",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "cleanAndReInstall": "rimraf node_modules package-lock.json && npm install --verbose --legacy-peer-deps",
    "listen": "hdc rport tcp:8081 tcp:8081",
    "lint": "eslint .",
    "start": "react-native start --reset-cache",
    "dev": "react-native bundle-harmony --dev false --bundle-output ./harmony/entry/src/main/resources/rawfile/bundle.harmony.js",
    "codegen": "react-native codegen-harmony --cpp-output-path ./harmony/entry/src/main/cpp/generated --rnoh-module-path ./harmony/entry/oh_modules/@rnoh/react-native-openharmony --no-safety-check"
  },
  "dependencies": {
    "@gorhom/portal": "^1.0.14",
    "@react-native-oh/react-native-harmony": "0.86.1",
    "@react-native-oh/react-native-harmony-cli": "0.86.1",
    "@react-native-ohos/react-native-gesture-handler": "2.31.0-beta.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^2.33.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "^0.86.3",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.3.1",
    "rimraf": "^5.0.5",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
