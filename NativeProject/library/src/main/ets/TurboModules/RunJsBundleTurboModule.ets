import {TurboModule, AnyThreadTurboModule } from '../../../../Index';
import {
  AnyJSBundleProvider,
  AnyThreadTurboModuleContext,
  CppFeatureFlag,
  JSBundleProvider,
  NapiBridge,
  ResourceJSBundleProvider,
  RNOHCoreContext,
  MetroJSBundleProvider,
  TraceJSBundleProviderDecorator } from '@rnoh/react-native-openharmony'

export class RunJsBundleTurboModule extends AnyThreadTurboModule {
  // private napiBridge: NapiBridge;
  public jsBundleProvider: JSBundleProvider | undefined = undefined
  private rnohCoreContext: RNOHCoreContext | undefined = AppStorage.get('RNOHCoreContext');
  constructor(
    ctx: AnyThreadTurboModuleContext,
  ) {
    super(ctx);
  }

  runJsBundle(path: string){
    console.log("chy v8 RunJsBundleTurboModule start path:", path)
    this.jsBundleProvider = new TraceJSBundleProviderDecorator(
      new AnyJSBundleProvider([
        new ResourceJSBundleProvider(this.rnohCoreContext!.uiAbilityContext.resourceManager, path)
      ]),
      this.rnohCoreContext!.logger
    );
    this.ctx.rnInstance.loadJsbundle(this.jsBundleProvider);
  }

  execute(methodName: string, data: string, Testcallback: (result: string) => void): Promise<string>{
    console.log("chy v8 execute start")
    // let {data1, Theme, isSapphirePlus, samMapBeautify} = JSON.parse(data);
    let data1 = "";
    let Theme = true;
    let isSapphirePlus = false;
    let samMapBeautify = true;
    let dataTest = JSON.stringify([data1, Theme, isSapphirePlus, samMapBeautify])
    // 测试执行workerRSA.jx文件中的 generateRSAKeys 方法
    // methodName = "generateRSAKeys";
    // data = "[]";
    return new Promise((resolve, reject) => {
      this.ctx.rnInstance.execute(methodName, dataTest, (result: string) => {
        Testcallback(result)
        resolve(result)
        return ""
      })
      // console.log("chy v8 execute resolve")
      // resolve("2342342342")
    });
  }
}