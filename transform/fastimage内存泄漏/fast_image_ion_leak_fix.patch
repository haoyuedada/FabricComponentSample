 FastImageViewComponentInstance::~FastImageViewComponentInstance()
 {
+    // 先取消在途请求：否则组件销毁后解码仍会完成并写入缓存，
+    // 解码出的 PixelMap（DMA-BUF/ION）在请求对象释放前一直由 fd 持有。
+    releaseImageKnifeRequest();
     // The original handle is released by the ARKUI node. It is not released again here
     m_imageKnifeNode->DisposeNode(false);
 }
 
+void FastImageViewComponentInstance::releaseImageKnifeRequest()
+{
+    if (!m_imageKnifeNode) {
+        return;
+    }
+    auto request = m_imageKnifeNode->GetImageKnifeRequest();
+    if (request && request->GetStatus() == ImageKnifePro::ImageKnifeRequest::Status::PROGRESS) {
+        ImageKnifePro::ImageKnife::GetInstance().CancelRequest(request);
+    }
+    // 解除监听，避免组件析构后仍收到回调
+    if (m_imageKnifeOption) {
+        m_imageKnifeOption->onLoadListener = nullptr;
+        m_imageKnifeOption->progressListener = nullptr;
+    }
+}
+
+bool FastImageViewComponentInstance::applyUpdate()
+{
+    // 组件尺寸未知时不发起加载：ImageKnife 的降采样依赖组件测算尺寸，
+    // 尺寸为 0 时无法降采样，会按原图分辨率解码（本次 ION 泄漏主因）。
+    if (m_targetWidth == 0 || m_targetHeight == 0) {
+        m_pendingUpdate = true;
+        return false;
+    }
+
+    std::string currentSrc;
+    if (!m_imageKnifeOption->loadSrc.GetString(currentSrc)) {
+        // Resource / PixelMap 类型：用 ToString() 作为变更标识
+        currentSrc = m_imageKnifeOption->loadSrc.ToString();
+    }
+    if (currentSrc.empty()) {
+        // 还没有有效图片源（布局先于 props 到达），等 props 到位后再发起加载
+        m_pendingUpdate = true;
+        return false;
+    }
+
+    const int32_t objectFit = static_cast<int32_t>(m_imageKnifeOption->objectFit);
+
+    // 仅在真正影响加载结果的属性变化时才发起新请求。
+    // 原实现每次 props 变化（如 tintColor、边框等）都会调用 Update()，
+    // 导致同一组件反复解码，旧 PixelMap 滞留（实测同一节点 23 份）。
+    if (!m_pendingUpdate && currentSrc == m_lastLoadSrc &&
+        m_targetWidth == m_appliedWidth && m_targetHeight == m_appliedHeight &&
+        objectFit == m_appliedObjectFit) {
+        return false;
+    }
+
+    // 按组件实际尺寸降采样。DEFAULT 仅在超过 7680x4320 时才缩放，
+    // 无法覆盖 6480x6480 这类大图，必须显式指定策略。
+    m_imageKnifeOption->downSampling = ImageKnifePro::DownSamplingStrategy::FIT_CENTER_MEMORY;
+
+    m_imageKnifeNode->SetWidth(static_cast<float>(m_targetWidth));
+    m_imageKnifeNode->SetHeight(static_cast<float>(m_targetHeight));
+    m_imageKnifeNode->Update(m_imageKnifeOption);
+
+    m_lastLoadSrc = currentSrc;
+    m_appliedWidth = m_targetWidth;
+    m_appliedHeight = m_targetHeight;
+    m_appliedObjectFit = objectFit;
+    m_pendingUpdate = false;
+    return true;
+}
+
+void FastImageViewComponentInstance::onLayoutChanged(
+    facebook::react::LayoutMetrics const &layoutMetrics)
+{
+    CppComponentInstance::onLayoutChanged(layoutMetrics);
+
+    const auto width = static_cast<uint32_t>(std::lround(layoutMetrics.frame.size.width));
+    const auto height = static_cast<uint32_t>(std::lround(layoutMetrics.frame.size.height));
+    if (width == m_targetWidth && height == m_targetHeight) {
+        return;
+    }
+    m_targetWidth = width;
+    m_targetHeight = height;
+    applyUpdate();
+}
