    "@react-native-ohos/react-native-reanimated": "^4.0.0-rc.1",
    "@react-native-ohos/react-native-worklets": "^1.0.0-rc.1",
    "@react-native-ohos/react-native-spring-scrollview": "3.1.0",
    "fabric-component-sample-package": "file:../fabric-component-sample-package/fabric-component-sample-package-1.0.0.tgz",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "semver": "7.7.1",
    "react-native-worklets": "0.7.1",
    "@gorhom/portal": "^1.0.14",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@fortawesome/react-native-fontawesome": "^0.3.2",
    "@rnoh/testerino": "file:./rnoh_package/testerino/rnoh-testerino-0.0.12.tgz"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.3.1",
    "rimraf": "^5.0.5",
    "typescript": "5.5.4"
  },
