
const BASE_64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';

function test(map_size_x,map_size_y,has){
    return {
        valid_min_x:initialProps.valid_min_x,
        valid_max_x:initialProps.valid_max_x,
        valid_min_y:initialProps.valid_min_y,
        valid_max_y:initialProps.valid_max_y,
        has:has
    };
}
//组装米家原生base64参数
function assemblyMiParam(array){
    const data_len = array[0];
    const mapData = array[1];
    const map_size_x = array[2];
    const map_size_y = array[3];
    const hasCustomFloor = array[4];
    const SCCMapColor = array[5];
    const rooms = array[6];
    const colorIdDic = array[7];
    const SMapValueType = array[8];
    const isSupportCarpet = array[9];
    const isSupportRealTimeCarpet = array[10];
    const isBaseSeries = array[11];
    const valueDic = {};
    let pointArray = [];
    let mapDataArray = [];
    
    initialProps.valid_min_x = 400;
    initialProps.valid_max_x = 400;
    initialProps.valid_min_y = 400;
    initialProps.valid_max_y = 400;
    
    let hasBeauty = false;// 是否有美化区域
    let string = '';

    const pixel = isBaseSeries ? 5 : 1;
    //const pixel = 1;
    //边缘放大一个像素点
    const minX = initialProps.valid_min_x - pixel;
    const maxX = initialProps.valid_max_x + pixel;
    const minY = initialProps.valid_min_y - pixel;
    const maxY = initialProps.valid_max_y + pixel;

    let sizeX = maxX - minX;
    let sizeY = maxY - minY;
    
    if(initialProps.isOptimizeMap){
        //取出地图有效区域
        for (let i = 0; i < data_len; i++) {
            const uType = mapData[i];
            
            const col = i % map_size_x;// 行
            const row = Math.floor(i / map_size_x);// 列
            findMapValidRect(row, col, uType, map_size_y);
        }
        
        
        
        //获取有效区域点
        let filterArray = new Array(sizeX * sizeY).fill(0);// 创建空白数组
        for (let k = minY; k <= maxY; k++) {
            for (let i = minX; i <= maxX; i++) {
                const idx = (map_size_y - k) * map_size_x + i;
                const val = mapData[idx];
                const vi = (sizeY - (k - minY)) * sizeX + (i - minX);
                if(vi < filterArray.length){
                    filterArray[vi] = Number(val);
                }
            }
        }
        filterArray = mapInterpolation(filterArray,sizeX,sizeY);
        
        sizeX *= initialProps.mapMultiple;
        sizeY *= initialProps.mapMultiple;
        
        for (let m = 0; m < filterArray.length; m++) {
            const uType = filterArray[m];
            const type = uType > 127 ? (uType - 256) : uType; // uint8->int8
            const colorOB = _getColorValue(type,SCCMapColor,SMapValueType);
            let colorValue = colorOB.value;
            let typeStr = `${ colorValue }`;
            if (typeStr != undefined && !isNaN(parseInt(typeStr))) {
                //valueDic[typeStr] = typeStr;
                if (valueDic[typeStr] == undefined){
                    valueDic[typeStr] = '1'
                } else {
                    valueDic[typeStr] = parseInt(valueDic[typeStr]) + 1 + '';
                }
            }
            if(colorValue == -2){
                filterArray[m] = typeStr;
                // 获取是否有美化区域
                if (colorValue == -2 && !hasBeauty) {
                    hasBeauty = true;
                }
                continue;
            }
            const col = m % sizeX;// 行
            const row = Math.floor(m / sizeX);// 列
            
            // 根据房间id获取地板材质 1:水泥地面 2:瓷砖 3:木地板 30:其他
            if (colorValue >= SCCMapColor.roomBegin && colorValue <= SCCMapColor.roomEnd) {
                let idx = colorValue - 10; idx = idx % initialProps.textureColors.length;
                if(colorIdDic[colorValue + '']){
                    idx = Number(colorIdDic[colorValue + '']) - 1;  
                }
                typeStr = 10 + idx;
                if (isSupportRealTimeCarpet) {
                    if (isSupportCarpet 
                        && (colorOB.type == SMapValueType.negative) 
                        && checkShowCarpet(col, row)){
                    typeStr = '-3';
                    }
                }
                if (hasCustomFloor) {
                    const meterialType = getRoomMeteriaType(colorValue,rooms);
                    if (meterialType == 2) {
                        typeStr = getCeramicTileTextureType(row, col, 10 + idx);
                    } else if (meterialType == 3) {
                        typeStr = getWoodFloorTextureType(row, col, idx + 10);
                    }
                }
            }
            if (typeStr == undefined || isNaN(parseInt(typeStr))) {
                typeStr = '0';
            }
            if (isSupportRealTimeCarpet) {
                if (colorValue == SCCMapColor.patch_carpet || colorValue == SCCMapColor.carpet) {
                        if(isSupportCarpet){
                            if (checkShowCarpet(col, row)){
                                typeStr = '-3';
                            } else {
                                typeStr = '1';
                            }
                        } else if (colorValue == SCCMapColor.patch) {
                            typeStr = typeStr;
                        } else if (colorValue == SCCMapColor.carpet) {
                            typeStr = '1';
                        }
                }
            }
            filterArray[m] = typeStr;
        }
        pointArray = filterArray;
        string = filterArray.join(',');
    }else{
        for (let i = 0; i < data_len; i++) {
            const uType = mapData[i];
            const type = uType > 127 ? (uType - 256) : uType; // uint8->int8

            const col = i % map_size_x;// 行
            const row = Math.floor(i / map_size_x);// 列
            findMapValidRect(row, col, type, map_size_y);
            const colorOB = _getColorValue(type,SCCMapColor,SMapValueType);
            let colorValue = colorOB.value;
            let typeStr = colorValue+'';
            valueDic[typeStr] = typeStr;
            //mapDataArray[i] = colorValue;
            mapDataArray.push(colorValue);
            
            // 获取是否有美化区域
            if (colorValue == -2 && !hasBeauty) {
                hasBeauty = true;
            }

            // 根据房间id获取地板材质 1:水泥地面 2:瓷砖 3:木地板 30:其他
            if (colorValue >= SCCMapColor.roomBegin && colorValue <= SCCMapColor.roomEnd) {
                let idx = colorValue - 10; idx = idx % initialProps.textureColors.length;
                typeStr = 10 + idx;
                if (hasCustomFloor) {
                    const meterialType = getRoomMeteriaType(colorValue,rooms);
                    if (meterialType == 2) {
                        typeStr = getCeramicTileTextureType(row, col, idx + 10);
                    } else if (meterialType == 3) {
                        typeStr = getWoodFloorTextureType(row, col, idx + 10);
                    }
                }
            }
            pointArray.push(typeStr);
            //pointArray[i] = typeStr;
        }
        string = pointArray.join(',');
    }
    
    return {
        valid_min_x:initialProps.valid_min_x,
        valid_max_x:initialProps.valid_max_x,
        valid_min_y:initialProps.valid_min_y,
        valid_max_y:initialProps.valid_max_y,
        hasBeauty,
        valueDic,
        mapDataArray,
        pointString:string,
        sizeX,
        sizeY,
        pointArray
    };
}

//组装米家原生base64参数（已知地图有效区域）
function assemblyWithMapBorderMiParam(array){
    const data_len = array[0];
    const mapData = array[1];
    const map_size_x = array[2];
    const map_size_y = array[3];
    const hasCustomFloor = array[4];
    const SCCMapColor = array[5];
    const rooms = array[6];
    const colorIdDic = array[7];
    initialProps.valid_min_x = array[8];
    initialProps.valid_max_x = array[9];
    initialProps.valid_min_y = array[10];
    initialProps.valid_max_y = array[11];
    const SMapValueType = array[12];
    const isSupportCarpet = array[13];
    const isSupportRealTimeCarpet = array[14];
    const isBaseSeries = array[15];

    const valueDic = {};
    let pointArray = [];
    let mapDataArray = [];
    
    let hasBeauty = false;// 是否有美化区域
    let string = '';

    //边缘放大一个像素点
    const pixel = isBaseSeries ? 5 : 1;
    //const pixel = 1;
    const minX = initialProps.valid_min_x - pixel;
    const maxX = initialProps.valid_max_x + pixel; 
    const minY = initialProps.valid_min_y - pixel;
    const maxY = initialProps.valid_max_y + pixel;

    let sizeX = maxX - minX;
    let sizeY = maxY - minY;

    if(initialProps.isOptimizeMap){
        //获取有效区域点
        let filterArray = new Array(sizeX * sizeY).fill(0);// 创建空白数组
        for (let k = minY; k <= maxY; k++) {
            for (let i = minX; i <= maxX; i++) {
                const idx = (map_size_y - k) * map_size_x + i;
                const val = mapData[idx];
                const vi = (sizeY - (k - minY)) * sizeX + (i - minX);
                if(vi < filterArray.length){
                    filterArray[vi] = Number(val);
                }
            }
        }
        filterArray = mapInterpolation(filterArray,sizeX,sizeY);
        
        sizeX *= initialProps.mapMultiple;
        sizeY *= initialProps.mapMultiple;
        
        for (let m = 0; m < filterArray.length; m++) {
            const uType = filterArray[m];
            const type = uType > 127 ? (uType - 256) : uType; // uint8->int8
            const colorOB = _getColorValue(type,SCCMapColor,SMapValueType);
            let colorValue = colorOB.value;
            let typeStr = `${ colorValue }`;
            if (typeStr != undefined && !isNaN(parseInt(typeStr))) {
                //valueDic[typeStr] = typeStr;
                if (valueDic[typeStr] == undefined){
                    valueDic[typeStr] = '1'
                } else {
                    valueDic[typeStr] = parseInt(valueDic[typeStr]) + 1 + '';
                }
            }
            if(colorValue == -2){
                filterArray[m] = typeStr;
                // 获取是否有美化区域
                if (colorValue == -2 && !hasBeauty) {
                    hasBeauty = true;
                }
                continue;
            }
            const col = m % sizeX;// 行
            const row = Math.floor(m / sizeX);// 列
            // TODO:测试图添加边界
            // if (col == 0 || col == sizeX - 1 || row == 0 || row == sizeY - 1){
            //     filterArray[m] = '-1';
            //     continue;
            // }
            // 根据房间id获取地板材质 1:水泥地面 2:瓷砖 3:木地板 30:其他
            if (colorValue >= SCCMapColor.roomBegin && colorValue <= SCCMapColor.roomEnd) {
                let idx = colorValue - 10; idx = idx % initialProps.textureColors.length;
                if(colorIdDic[colorValue + '']){
                    idx = Number(colorIdDic[colorValue + '']) - 1;  
                }
                typeStr = 10 + idx;
                if (isSupportRealTimeCarpet) {
                    if (isSupportCarpet 
                        && (colorOB.type == SMapValueType.negative) 
                        && checkShowCarpet(col, row)){
                    typeStr = '-3';
                    }
                }
                if (hasCustomFloor) {
                    const meterialType = getRoomMeteriaType(colorValue,rooms);
                    if (meterialType == 2) {
                        typeStr = getCeramicTileTextureType(row, col, 10 + idx);
                    } else if (meterialType == 3) {
                        typeStr = getWoodFloorTextureType(row, col, idx + 10);
                    }
                }
            }
            if (typeStr == undefined || isNaN(parseInt(typeStr))) {
                typeStr = '0';
            }
            if (isSupportRealTimeCarpet) {
                if (colorValue == SCCMapColor.patch_carpet || colorValue == SCCMapColor.carpet) {
                        if(isSupportCarpet){
                            if (checkShowCarpet(col, row)){
                                typeStr = '-3';
                            } else {
                                typeStr = '1';
                            }
                        } else if (colorValue == SCCMapColor.patch) {
                            typeStr = typeStr;
                        } else if (colorValue == SCCMapColor.carpet) {
                            typeStr = '1';
                        }
                }
            }
            filterArray[m] = typeStr;
        }
        pointArray = filterArray;
        string = filterArray.join(',');
    }
    
    return {
        valid_min_x:initialProps.valid_min_x,
        valid_max_x:initialProps.valid_max_x,
        valid_min_y:initialProps.valid_min_y,
        valid_max_y:initialProps.valid_max_y,
        hasBeauty,
        valueDic,
        mapDataArray,
        pointString:string,
        sizeX,
        sizeY,
        pointArray
    };
}

/**
 * 插值算法
 */
function mapInterpolation(matSrc,sizeX,sizeY){
  const MAP_SCALE = initialProps.mapMultiple;
  const tSizeX = sizeX * MAP_SCALE;
  const tSizeY = sizeY * MAP_SCALE;
  let matDst = new Array(sizeX * sizeY * MAP_SCALE * MAP_SCALE).fill(0);
  for (let i = 0; i < sizeY; i++) {
    for (let j = 0; j < sizeX; j++) {
      for (let row_k = 0; row_k < MAP_SCALE; row_k++) {
        for (let col_k = 0; col_k < MAP_SCALE; col_k++) {
          const idx = (i * MAP_SCALE + row_k) * tSizeX + j * MAP_SCALE + col_k;
          matDst[idx] = matSrc[i * sizeX + j];
        }
      }
    }
  }
  return matDst;
}
function findMapValidRect(k, m, type,map_size_y){
    if (type != 0) {
        if (m < initialProps.valid_min_x) {
            initialProps.valid_min_x = m;
        } else if (m > initialProps.valid_max_x) {
            initialProps.valid_max_x = m;
        }

        const y = map_size_y - k;
        if (y < initialProps.valid_min_y) {
            initialProps.valid_min_y = y;
        } else if (y > initialProps.valid_max_y) {
            initialProps.valid_max_y = y;
        }
    }
}
function _getColorValue(type,SCCMapColor,SMapValueType){
    if (type >= SCCMapColor.coverRoomBegin && type <= SCCMapColor.coverRoomEnd) {
        return { value:type - 50, type:SMapValueType.cover };
    } 
    if (type >= SCCMapColor.deepCoverRoomBegin && type <= SCCMapColor.deepCoverRoomEnd) {
        return { value:-type - 50, type:SMapValueType.negative };
    }
    return { value:type, type:SMapValueType.simple };
}
function checkShowCarpet(x, y){
  if (x % 3 == 0 && y % 3 == 0){
      return true;
  } 
  if (x % 3 == 0 && y % 3 == 0){
      return true;
  } 
  return false;
}
function getRoomMeteriaType(type,rooms){
    for (const room of rooms) {
        if (room.roomId == type) {
            return room.meterialId;
        }
    }
    return type;
}
function getWoodFloorTextureType(row, col, type){
    const rowMod = row % initialProps.woodFloorInfo.wood_floor_height;
    const colMod = col % initialProps.woodFloorInfo.wood_floor_width;
    const index =colMod + rowMod * initialProps.woodFloorInfo.wood_floor_width;

    const array = initialProps.woodFloorInfo.woodFloorTexture[type];
    return array[index];
}
function getCeramicTileTextureType(row, col, type){
    const rowMod = row % initialProps.ceramicTileInfo.ceramic_tile_height;
    const colMod = col % initialProps.ceramicTileInfo.ceramic_tile_width;
    const index = colMod + rowMod * initialProps.ceramicTileInfo.ceramic_tile_width;

    const array = initialProps.ceramicTileInfo.ceramicTileTexture[type];
    return array[index];
}
