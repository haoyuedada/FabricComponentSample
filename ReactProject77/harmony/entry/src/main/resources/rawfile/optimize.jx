function Optimize3(mapInfo, picW, picH,chargePos,saveCleanMap,info,gridWidth){
    var oldMapInfo = [];
    for (var i = 0; i < mapInfo.length; i++) {
        oldMapInfo[i] = mapInfo[i];
    }
    clearLaminatedWall(mapInfo, picW, picH);
    clearBorder(mapInfo);
    fillMapData(mapInfo, picW, picH, 2, 3, 3);//填充障碍物
    denoise(mapInfo, picW, picH);
    denoise2(mapInfo, picW, picH);
    updateBorderValue(mapInfo, picW, picH, 5);
    fillCrossLine(mapInfo, picW, picH, 5)
    linkAdjacentAreas(oldMapInfo,mapInfo, picW, picH, 5);
    var ret = findOutLine(mapInfo, picW, picH, 5,true);
    if(!ret){
        return null;
    }
    updateBorderValue(mapInfo, picW, picH, 6);
    var cChargePos = undefined;
    if(chargePos!=undefined&&chargePos.angle!=32767){
        var index = Math.floor(chargePos.y)*picW+Math.floor(chargePos.x);
        if(mapInfo[index]!=0){
            cChargePos = calculateChargePos(mapInfo,picW,picH,6,chargePos);
        }
    }
    
    findOutLine(mapInfo, picW, picH, 6);
   
    
    
    fillMapData2(mapInfo, picW, picH);
    clearSmallObstacle(mapInfo, picW, picH, 3);
    updateBorderValue(mapInfo, picW, picH, 7);
    
 
    for(var i=0;i<mapInfo.length;i++){
        var value = mapInfo[i];
        
        if(value == 0){
            // mapInfo[i] = 0;
        }else if(value == 2||value == 7){
            mapInfo[i] = 2;
        }else if(value == 3){
            mapInfo[i] = 1;
        }else{
            mapInfo[i] = 1;
        }
    }
    if(saveCleanMap){
        var _x = info.minX;
        var _y = info.minY;
    
        if(_x > saveCleanMap.x){
            _x = saveCleanMap.x;
        }
        if(_y > saveCleanMap.y){
            _y = saveCleanMap.y;
        }
        var pngWidth = picW;
        var pngHeight = picH;
        var maxX1 = info.minX + gridWidth*pngWidth;
        var maxY1 = info.minY + gridWidth*pngHeight;
        var maxX2 = saveCleanMap.x + gridWidth * saveCleanMap.width;
        var maxY2 = saveCleanMap.y + gridWidth * saveCleanMap.height;

        var maxX = maxX1>maxX2?maxX1:maxX2;
        var maxY = maxY1>maxY2?maxY1:maxY2;
            
        var nw = (maxX-_x)/gridWidth;
        var nh = (maxY-_y)/gridWidth;
        var _mapInfo = [];
        for(var j=0;j<nh;j++){
            for(var i=0;i<nw;i++){
                _mapInfo[j*nw+i] = 0;
                var si = (saveCleanMap.x - _x)/gridWidth;
                var sj = (saveCleanMap.y - _y)/gridWidth;
                var ni = (info.minX-_x)/gridWidth;
                var nj = (info.minY-_y)/gridWidth;
                var saveValue = undefined;
                if(j>=sj&&i>=si&&j<sj+saveCleanMap.height&&i<si+saveCleanMap.width){
                    saveValue = saveCleanMap.mapInfo[(j-sj)*saveCleanMap.width+(i-si)];
                }
                var cleanValue = undefined;
                if(j>=nj&&i>=ni&&j<nj+pngHeight&&i<ni+pngWidth){
                    cleanValue = mapInfo[(j-nj)*pngWidth+(i-ni)];
                }
                if(saveValue==undefined||saveValue==0){
                    if(cleanValue == 1){
                        _mapInfo[j*nw+i] = 1;
                    }
                }else{
                    if(saveValue == 2){
                        _mapInfo[j*nw+i] = 2;
                    }else if(saveValue == 1){
                        if(cleanValue == 1){
                            _mapInfo[j*nw+i] = 1;
                        }else{
                            _mapInfo[j*nw+i] = 3;
                        }
                    }
                }
            }
        }
          picW = nw;
          picH = nh;
          mapInfo = _mapInfo;
          cChargePos = undefined;
          info.minX = _x;
          info.minY = _y;
        }
    var points =  mapInfo.join(",")
    return {
        picH:picH,
        picW:picW,
        Multiple:1,
        points:points,
        info:info,
        chargePos:cChargePos
    }
}

function Optimize4(mapInfo, picW, picH,chargePos,saveCleanMap,info,gridWidth){
    picW = saveCleanMap.width;
    picH = saveCleanMap.height;
    var points = saveCleanMap.mapInfo.join(",");
    info.minX = saveCleanMap.x;
    info.minY = saveCleanMap.y;
    var cChargePos = {
        x:(saveCleanMap.chargePos.x-saveCleanMap.x)/gridWidth,
        y:(saveCleanMap.chargePos.y-saveCleanMap.y)/gridWidth,
        angle:saveCleanMap.chargePos.angle
    };
    return {
        picH:picH,
        picW:picW,
        Multiple:1,
        points:points,
        info:info,
        chargePos:cChargePos
    }
}

function Optimize0(mapInfo, picW, picH,chargePos,saveCleanMap,info,gridWidth){
    
    var points = mapInfo.join(",");
    return {
        picH:picH,
        picW:picW,
        Multiple:1,
        points:points
    }
}

function calculateChargePos(mapInfo, picW, picH,strokeValue,chargerPos) {
    var vLines = [];
    var hLines = [];
    for (var i = 0; i < picW; i++) {
        var startY = -1;
        for (var j = 0; j < picH; j++) {
            var index = j * picW + i;
            var lastY = j - 1;
            if (mapInfo[index] == strokeValue && j != picH - 1) {
                var isCross = false;
                if ((i!=0&&mapInfo[index - 1] == strokeValue) || (i!=picW-1&&mapInfo[index + 1] == strokeValue)) {
                    isCross = true;
                }
                if (startY < 0 && isCross) {
                    startY = j;
                    continue;
                }
                if (!isCross) {
                    continue;
                }
                lastY = j;
            }
            if (startY >= 0) {
                if (j == picH - 1 && mapInfo[index] == strokeValue) {
                    lastY = j;
                }
                if (lastY == startY) {
                    startY = -1;
                    continue;
                }
                var isCross = false;
                var lastIndex = lastY * picW + i;
                if (mapInfo[lastIndex - 1] == strokeValue || mapInfo[lastIndex + 1] == strokeValue) {
                    isCross = true;
                }
                if (isCross) {
                    var p0 = {
                        x:i,
                        y:startY
                    }
                    var p1 = {
                        x:i,
                        y:lastY
                    }
                    vLines.push({
                        p0:p0,
                        p1:p1
                    })
                    startY = lastY;
                    continue;
                }



            }
            startY = -1;
        }
    }
    for (var j = 0; j < picH; j++) {
        var startX = -1;
        for (var i = 0; i < picW; i++) {
            var index = j * picW + i;
            var lastX = i - 1;
            if (mapInfo[index] == strokeValue && i != picW - 1) {

                var isCross = false;
                if (mapInfo[index - picW] == strokeValue || mapInfo[index + picW] == strokeValue) {
                    isCross = true;
                }
                if (startX < 0 && isCross) {
                    startX = i;
                    continue;
                }
                if (!isCross) {
                    continue;
                }
                lastX = i;
            }
            if (startX >= 0) {
                if (mapInfo[index] == strokeValue && i == picW - 1) {
                    lastX = i;
                }

                if (lastX == startX) {
                    startX = -1;
                    continue;
                }
                var isCross = false;
                var lastIndex = j * picW + lastX;
                if (mapInfo[lastIndex - picW] == strokeValue || mapInfo[lastIndex + picW] == strokeValue) {
                    isCross = true;
                }
                if (isCross) {
                    var p0 = {
                        x:startX,
                        y:j
                    }
                    var p1 = {
                        x:lastX,
                        y:j
                    }
                    hLines.push({
                        p0:p0,
                        p1:p1
                    })
                   
                    startX = lastX;
                    continue;
                }

            }
            startX = -1;
        }
    }

    var cX = Math.floor(chargerPos.x);
    var cY = Math.floor(chargerPos.y);
    if(Math.abs(chargerPos.angle-180)<=30){
        chargerPos.angle = 180;
        var lastX = undefined;
        for(var i=0;i<vLines.length;i++){
            var line = vLines[i];
            var lx = line.p0.x;
            var minY = line.p0.y<line.p1.y?line.p0.y:line.p1.y;
            var maxY = line.p0.y>line.p1.y?line.p0.y:line.p1.y;
            if(lx>=cX&&cY>=minY&&cY<=maxY){
                if(lastX == undefined||lx<lastX){
                    lastX = lx;
                }
            }
        }
        if(lastX!=undefined){
            if(lastX - cX<=11){
                chargerPos.angle = 180;
                chargerPos.x = lastX + 0.5;
            }
        }
    }else if(Math.abs(chargerPos.angle-360)<=30||Math.abs(chargerPos.angle)<=30){
        chargerPos.angle = 360;
        var lastX = undefined;
        for(var i=0;i<vLines.length;i++){
            var line = vLines[i];
            var lx = line.p0.x;
            var minY = line.p0.y<line.p1.y?line.p0.y:line.p1.y;
            var maxY = line.p0.y>line.p1.y?line.p0.y:line.p1.y;
            if(lx<=cX&&cY>=minY&&cY<=maxY){
                if(lastX == undefined||lx>lastX){
                    lastX = lx;
                }
            }
        }
        if(lastX!=undefined){
            if(cX-lastX<=11){
                chargerPos.angle = 360;
                chargerPos.x = lastX+0.5;
            }
        }
    }else if(Math.abs(Math.abs(chargerPos.angle-270)<=30)){
        var lastY = undefined;
        for(var i=0;i<hLines.length;i++){
            var line = hLines[i];
            var ly = line.p0.y;
            var minX = line.p0.x<line.p1.x?line.p0.x:line.p1.x;
            var maxX = line.p0.x>line.p1.x?line.p0.x:line.p1.x;
            if(ly>=cY&&cX>=minX&&cX<=maxX){
                if(lastY == undefined||ly<lastY){
                    lastY = ly;
                }
            }
        }
        if(lastY!=undefined){
            if(lastY-cY<=11){
                chargerPos.angle = 270;
                chargerPos.y = lastY + 0.5;
            }
        }
    }else if(Math.abs(Math.abs(chargerPos.angle-90)<=30)){
        var lastY = undefined;
        for(var i=0;i<hLines.length;i++){
            var line = hLines[i];
            var ly = line.p0.y;
            var minX = line.p0.x<line.p1.x?line.p0.x:line.p1.x;
            var maxX = line.p0.x>line.p1.x?line.p0.x:line.p1.x;
            if(ly<=cY&&cX>=minX&&cX<=maxX){
                if(lastY == undefined||ly>lastY){
                    lastY = ly;
                }
            }
        }
        if(lastY!=undefined){
            if(cY - lastY<=11){
                chargerPos.angle = 90;
                chargerPos.y = lastY + 0.5;
            }
        }
    }
    return chargerPos;
}

function OptimizeNew(mapInfo, picW, picH,chargePos,hasSaveMap){
    var oldMapInfo = [];
    var pointNum = 0;
    for (var i = 0; i < mapInfo.length; i++) {
        if(mapInfo[i] == 255){
            mapInfo[i] = 2;
        }
        oldMapInfo[i] = mapInfo[i];
        if(mapInfo[i]!=0){
            pointNum++;
        }
        
    }
    clearLaminatedWall(mapInfo, picW, picH);
    clearBorder(mapInfo);
    fillMapData(mapInfo, picW, picH, 2, 3, 3);//填充障碍物
    denoise(mapInfo, picW, picH);
    denoise2(mapInfo, picW, picH);
    updateBorderValue(mapInfo, picW, picH, 5);
    fillCrossLine(mapInfo, picW, picH, 5)
    linkAdjacentAreas(oldMapInfo,mapInfo, picW, picH, 5);
    var ret = findOutLine(mapInfo, picW, picH, 5,true);
    if(!ret){
        return {
            mapInfo:oldMapInfo
        };
    }
    fillMapData2(mapInfo, picW, picH);
    updateBorderValue(mapInfo, picW, picH, 6);
    var index = Math.floor(chargePos.y)*picW+Math.floor(chargePos.x);
    var cChargePos = undefined;
    if(chargePos.angle!=32767&&mapInfo[index]!=0){
        cChargePos = calculateChargePos(mapInfo,picW,picH,6,chargePos);
    }
    findOutLine(mapInfo, picW, picH, 6);
   
    
    
    fillMapData2(mapInfo, picW, picH);

    updateBorderValue(mapInfo, picW, picH, 7);
    findObstacleBorder(mapInfo, picW, picH, 3);
    var currentPointNum = 0;

    for(var i=0;i<mapInfo.length;i++){
        var value = mapInfo[i];
        
        if(value == 0){
            // mapInfo[i] = 0;
        }else if(value == 2||value == 7){
            mapInfo[i] = 2;
        }else if(value == 3){
            mapInfo[i] = 0;
        }else{
            mapInfo[i] = 1;
        }
        if(value!=0){
            currentPointNum ++;
        }
    }
    if(currentPointNum*100/pointNum<50&&pointNum>2000){
        return {
            mapInfo:oldMapInfo
        }
    }
    var obstacleMap = undefined;
    if(hasSaveMap){
        optimizeObstacle(oldMapInfo,picW, picH);
        optimizeObstacle(oldMapInfo,picW, picH);
        obstacleMap = oldMapInfo;
    }
    

    return {
        mapInfo:mapInfo,
        chargePos:cChargePos,
        obstacleMap:obstacleMap
    }
}

function optimizeObstacle(mapInfo,picW, picH){
    for (var j = 0; j < picH; j++) {
      for (var i = 0; i < picW; i++) {
        var index = j * picW + i;
        var cValue = mapInfo[index];
        if(cValue == 2){
            var left = (i == 0?0:mapInfo[index-1]);
            var right = (i == picW-1?0:mapInfo[index+1]);
            var top = (j == picH-1?0:mapInfo[index+picW]);
            var bottom = (j==0?0:mapInfo[index - picW]);
            if((left == 0&&right==2)||(left==2&&right==0)||(top==0&&bottom==2)||(top==2&&bottom==0)){
                mapInfo[index] = 0;
            }
        }
      }
    }
}

function findObstacleBorder(mapInfo, picW, picH, obstacleValue){
  for (var j = 0; j < picH; j++) {
    for (var i = 0; i < picW; i++) {
      var index = j * picW + i;
      if (mapInfo[index] == obstacleValue) {
        if (j == 0 || j == picH - 1 || i == 0 || i == picW - 1) {
          mapInfo[index] = 2;
          continue;
        }
        var hasFind = false;
        for (var _i = i - 1; _i <= i + 1; _i++) {
          for (var _j = j - 1; _j <= j + 1; _j++) {
            var nIndex = _j * picW + _i;
            if (mapInfo[nIndex] != obstacleValue && mapInfo[nIndex] != 2) {
              hasFind = true;
              break;
            }
          }
          if (hasFind) {
            break;
          }
        }
        if (hasFind) {
          mapInfo[index] = 2;
        }
      }
    }
  }

}

