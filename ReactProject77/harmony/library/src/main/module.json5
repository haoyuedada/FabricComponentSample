{
  "module": {
    "name": "library",
    "type": "shared",
    "deliveryWithInstall": true,
    "deviceTypes": [
      "default",
      "tablet",
      "2in1"
    ],
    "requestPermissions": [
      {
        "name" : "ohos.permission.ACCELEROMETER" // 加速度权限
      },
      {
        "name": "ohos.permission.GYROSCOPE" // 陀螺仪权限
      }
    ]

  }
}
